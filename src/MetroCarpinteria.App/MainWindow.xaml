<Window x:Class="MetroCarpinteria.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
        xmlns:ctl="clr-namespace:MetroCarpinteria.App.Controls"
        mc:Ignorable="d"
        Title="METRO CARPINTERÍA"
        MinWidth="1100"
        MinHeight="700"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <!-- Atajos globales. Van en la ventana y no en cada vista para que funcionen
         esté donde esté el foco. Ctrl+F es el único que necesita código: hay que
         encontrar el buscador de la sección activa en el árbol visual. -->
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Home}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Inventory}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.CashRegister}" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Quotes}" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Clients}" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Projects}" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Staff}" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Reports}" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static models:NavigationSection.Settings}" />

        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewInSectionCommand}" />
        <KeyBinding Key="OemQuestion" Modifiers="Control" Command="{Binding ToggleShortcutsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Auto + MinWidth en el panel: con un ancho fijo, en tamaño de letra
                 grande los títulos del menú quedaban cortados. -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                MinWidth="{DynamicResource SidebarWidth}"
                Background="{DynamicResource SidebarDarkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="20,28,20,24">
                    <Image Source="pack://application:,,,/MetroCarpinteria;component/Assets/logo-circle.jpeg"
                           Height="72"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                    <TextBlock Text="METRO CARPINTERÍA"
                               Foreground="{DynamicResource AccentGoldBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.85" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,0,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder"
                                                Background="Transparent"
                                                CornerRadius="10"
                                                Padding="16,14">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PrimaryBrownBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NavItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           Foreground="{DynamicResource TextOnDarkBrush}"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                                <!-- Sin Visibility como atributo: en WPF un valor local le gana
                                     al Setter del DataTrigger, así que el badge se dibujaba al
                                     lado de las nueve secciones en vez de solo en Inventario. -->
                                <Border Grid.Column="2"
                                        Background="{DynamicResource AlertBrush}"
                                        CornerRadius="10"
                                        MinWidth="20"
                                        MinHeight="20"
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Productos por debajo del stock mínimo">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section}" Value="{x:Static models:NavigationSection.Inventory}">
                                                    <Setter Property="Visibility" Value="{Binding DataContext.LowStockAlertCount, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntToVisibilityConverter}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DataContext.LowStockAlertCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Foreground="{DynamicResource ContentOnBrandBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Aviso de actualización lista, sobre Configuración -->
                                <Border Grid.Column="2"
                                        Background="{DynamicResource SuccessBrush}"
                                        CornerRadius="10"
                                        MinWidth="20"
                                        MinHeight="20"
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Hay una actualización lista. Se instala al cerrar la app.">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section}" Value="{x:Static models:NavigationSection.Settings}">
                                                    <Setter Property="Visibility" Value="{Binding DataContext.UpdateBadgeCount, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntToVisibilityConverter}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="↑"
                                               Foreground="{DynamicResource ContentOnBrandBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="20,16,20,24">
                    <Rectangle Height="1" Fill="{DynamicResource BorderStrongBrush}" Margin="0,0,0,16" />
                    <TextBlock Text="Gestión local"
                               Foreground="{DynamicResource TextOnDarkBrush}"
                               Opacity="0.5"
                               FontSize="11"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersionDisplay}"
                               Foreground="{DynamicResource AccentGoldBrush}"
                               Opacity="0.7"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Igual que el sidebar: la barra crece con la letra en vez de recortarla -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    MinHeight="{DynamicResource TopBarHeight}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushToken}"
                    BorderThickness="0,0,0,1"
                    Padding="32,8">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNavItem.Title}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CurrentDate}"
                                   Style="{StaticResource SubtitleStyle}"
                                   FontSize="12"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource StateWarningSurfaceBrush}"
                                CornerRadius="8"
                                Padding="12,6"
                                Margin="0,0,12,0"
                                Visibility="{Binding LowStockAlertCount, Converter={StaticResource IntToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource AlertBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold">
                                <Run Text="⚠ " />
                                <Run Text="{Binding LowStockAlertCount, Mode=OneWay}" />
                                <Run Text=" stock bajo" />
                            </TextBlock>
                        </Border>
                        <Image Source="pack://application:,,,/MetroCarpinteria;component/Assets/logo-horizontal.jpeg"
                               Height="36"
                               Stretch="Uniform"
                               Opacity="0.9" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentViewModel}"
                                x:Name="PageContent" />

                <!-- Los avisos flotantes van sobre el contenido de página, pero dentro del
                     área de contenido: así no tapan el menú lateral. Instanciados una sola
                     vez acá para que un aviso sobreviva al cambio de sección. -->
                <ctl:ToastHost x:Name="Toasts" />
            </Grid>
        </Grid>

        <!-- La capa de diálogo cubre la ventana entera, menú incluido: mientras hay una
             pregunta abierta no se puede navegar a otra parte y dejarla sin responder. -->
        <!-- Chuleta de atajos (Ctrl+/). Los que la buscan la encuentran; a los demás
             no les ocupa un centímetro de pantalla. -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource BusyOverlayStyle}"
                Visibility="{Binding AreShortcutsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource DialogSurfaceStyle}">
                <StackPanel>
                    <TextBlock Text="Atajos de teclado" FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="No hace falta usarlos: todo se puede hacer con el mouse."
                               Style="{StaticResource SubtitleStyle}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}"
                                            CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Keys}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Cerrar" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True"
                            Command="{Binding CloseOverlaysCommand}" />
                </StackPanel>
            </Border>
        </Border>

        <ctl:DialogHost x:Name="Dialogs" Grid.ColumnSpan="2" />
    </Grid>
</Window>
