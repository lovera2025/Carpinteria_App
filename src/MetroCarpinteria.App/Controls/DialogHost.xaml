<UserControl x:Class="MetroCarpinteria.App.Controls.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:MetroCarpinteria.App.Services"
             mc:Ignorable="d"
             Panel.ZIndex="1000"
             Visibility="Collapsed"
             KeyboardNavigation.TabNavigation="Cycle">

    <!--
        Capa de diálogo. Cubre toda la ventana y atrapa el foco mientras está abierta.
        TabNavigation="Cycle" hace que el tabulador no se escape a los controles de atrás,
        que quedarían accesibles pero tapados.
    -->
    <Grid x:Name="Root">
        <!-- El velo también intercepta los clics sobre lo que quedó detrás -->
        <Border Style="{StaticResource ScrimStyle}" />

        <Border x:Name="Surface" Style="{StaticResource DialogSurfaceStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border x:Name="IconBadge"
                            Style="{StaticResource StepBadgeStyle}"
                            MinWidth="34" MinHeight="34"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="IconText"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ContentOnBrandBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center"
                               MaxWidth="380" />
                </StackPanel>

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,22" />

                <WrapPanel HorizontalAlignment="Right">
                    <!-- Cancelar va primero y es el que recibe el foco: si alguien
                         apura un Enter, no se ejecuta la acción destructiva. -->
                    <Button x:Name="CancelButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            IsCancel="True"
                            Click="OnCancel" />
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Click="OnConfirm" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
