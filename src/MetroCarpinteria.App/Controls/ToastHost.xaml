<UserControl x:Class="MetroCarpinteria.App.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             IsHitTestVisible="True"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,24,24"
             Panel.ZIndex="900">

    <!--
        Se instancia una sola vez, en la ventana principal, encima del contenido de página.
        Vive acá y no en cada pantalla porque un aviso tiene que sobrevivir al cambio de
        sección: si lo dibujara cada vista, confirmar algo y navegar haría desaparecer la
        confirmación antes de poder leerla.

        AutomationProperties.LiveSetting hace que un lector de pantalla anuncie los avisos
        sin robar el foco de donde esté trabajando el usuario.
    -->
    <!-- El origen se asigna desde el code-behind y no con un Binding: este control hereda
         el DataContext de la ventana, así que un {Binding Items} apuntaría al ViewModel
         principal, que no tiene esa propiedad, y no se dibujaría ningún aviso. -->
    <ItemsControl x:Name="ItemsHost"
                  AutomationProperties.LiveSetting="Polite">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:ToastItem}">
                <Border AutomationProperties.Name="{Binding Message}">
                    <!-- La franja inferior de color es lo que distingue el tipo de aviso;
                         el ícono acompaña para no depender solo del color, que es lo que
                         necesita alguien que no distingue bien el rojo del verde. -->
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ToastSurfaceStyle}">
                            <Setter Property="BorderBrush" Value="{DynamicResource StateInfoBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Success}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource StateSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Warning}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource StateWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Error}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource StateDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Icon}"
                                   FontSize="{DynamicResource FontSizeSection}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Top"
                                   Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource StateInfoBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Success}">
                                            <Setter Property="Foreground" Value="{DynamicResource StateSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Warning}">
                                            <Setter Property="Foreground" Value="{DynamicResource StateWarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Error}">
                                            <Setter Property="Foreground" Value="{DynamicResource StateDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Message}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource ContentBrush}"
                                       TextWrapping="Wrap" />

                            <Button Content="Copiar el detalle"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="0,4,0,0"
                                    FontSize="{DynamicResource FontSizeCaption}"
                                    Click="OnCopyDetail"
                                    Tag="{Binding Detail}"
                                    ToolTip="Copia el error completo, para poder pegarlo en un mensaje"
                                    Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="✕"
                                Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Top"
                                Margin="8,-4,-4,0"
                                Click="OnDismiss"
                                Tag="{Binding}"
                                ToolTip="Cerrar el aviso"
                                AutomationProperties.Name="Cerrar el aviso" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
