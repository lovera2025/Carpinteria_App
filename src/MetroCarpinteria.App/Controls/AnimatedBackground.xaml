<UserControl x:Class="MetroCarpinteria.App.Controls.AnimatedBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid ClipToBounds="True">
        <Rectangle x:Name="GradientRect">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F5F0E8" Offset="0" />
                    <GradientStop Color="#EDE4D4" Offset="0.45" />
                    <GradientStop Color="#E8D5BC" Offset="0.75" />
                    <GradientStop Color="#F5F0E8" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="420"
                 Height="420"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-80,-100,0,0"
                 Opacity="0.35"
                 Fill="#33C4A574">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Orb1Transform" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse Width="360"
                 Height="360"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-60,-80"
                 Opacity="0.28"
                 Fill="#336B4423">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="Orb2Transform" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Rectangle Opacity="0.06">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Assets/banner.jpeg"
                            Stretch="UniformToFill"
                            AlignmentX="Center"
                            AlignmentY="Center" />
            </Rectangle.Fill>
        </Rectangle>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="GradientRect"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.92"
                                     To="1"
                                     Duration="0:0:5">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Orb1Transform"
                                     Storyboard.TargetProperty="X"
                                     From="0"
                                     To="40"
                                     Duration="0:0:7">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Orb1Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="0"
                                     To="30"
                                     Duration="0:0:7">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Orb2Transform"
                                     Storyboard.TargetProperty="X"
                                     From="0"
                                     To="-35"
                                     Duration="0:0:9">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Orb2Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="0"
                                     To="-25"
                                     Duration="0:0:9">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
