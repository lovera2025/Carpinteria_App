<Application x:Class="MetroCarpinteria.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:MetroCarpinteria.App.Helpers"
             xmlns:vm="clr-namespace:MetroCarpinteria.App.ViewModels"
             xmlns:views="clr-namespace:MetroCarpinteria.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                EL ORDEN DE ESTA LISTA ES PARTE DEL CONTRATO.

                ThemeService intercambia los dos primeros diccionarios por índice para
                cambiar de tema y de tamaño de letra en caliente:

                    [0] paleta      → Palette.Light.xaml / Palette.Dark.xaml
                    [1] tipografía  → Type.Small|Normal|Large.xaml

                Se reemplaza el elemento por índice y no se hace Clear()+Add(): un Clear
                invalida todos los recursos de una vez, lo que hace parpadear la ventana
                entera y puede fallar si algún binding se resuelve en el medio.

                Del [2] en adelante son fijos. Solo pueden contener Style y ControlTemplate,
                nunca colores: un estilo implícito se resuelve una única vez, cuando el
                elemento entra al árbol visual, así que si estuviera en un diccionario que
                se intercambia, los elementos ya dibujados se quedarían con el anterior.
                Por eso los estilos consumen todo por DynamicResource.

                Hay un test que verifica que [0] contiene SurfaceBrush y [1] FontSizeBody.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Theme/Palette.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Theme/Type.Normal.xaml" />

                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Tokens.xaml" />

                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/Text.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/Buttons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/Inputs.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/Selection.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/Surfaces.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/Lists.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/DataGrid.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/Scrolling.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Controls/Overlays.xaml" />

                <ResourceDictionary Source="pack://application:,,,/MetroCarpinteria;component/Resources/Animations.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:SectionEqualsConverter x:Key="SectionEqualsConverter" />
            <helpers:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />
            <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:SelectedOptionConverter x:Key="SelectedOptionConverter" />

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CashRegisterViewModel}">
                <views:CashRegisterView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:QuotesViewModel}">
                <views:QuotesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
                <views:ClientsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
                <views:ProjectsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StaffViewModel}">
                <views:StaffView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
