<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Escala de texto. Todo va por DynamicResource: los diccionarios de paleta y de
        tamaño se intercambian en caliente, y con StaticResource el valor quedaría
        congelado en el que había al cargar la pantalla.
    -->

    <!-- Implícito: cualquier TextBlock sin estilo hereda color y tipografía correctos -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}" />
        <Setter Property="Foreground" Value="{DynamicResource ContentMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Etiqueta de un campo de formulario -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ContentMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Texto de ayuda debajo de un campo -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource ContentSubtleBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource ContentMutedBrush}" />
    </Style>

    <Style x:Key="MicroStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}" />
        <Setter Property="Foreground" Value="{DynamicResource ContentSubtleBrush}" />
    </Style>

    <!-- Importes en tabla: monoespaciado para que las columnas de números se alineen -->
    <Style x:Key="MoneyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource ContentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="MoneyStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource MoneyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

</ResourceDictionary>
