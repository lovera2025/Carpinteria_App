<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ESCALA TIPOGRÁFICA — Normal

        Este diccionario se intercambia en caliente junto con la paleta, así que solo
        contiene valores: sys:Double y Thickness. Ningún estilo.

        El espaciado escala junto con la letra a propósito. Si solo creciera el texto y los
        márgenes quedaran fijos, en tamaño grande los controles se tocarían entre sí y la
        pantalla se vería peor que antes de agrandar.

        Por el mismo motivo, en los XAML las alturas con texto adentro van con MinHeight
        atado a estos valores y no con Height fijo: un Height="20" recorta la letra grande.
    -->

    <!-- Tamaños de letra -->
    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeSection">16</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeMicro">11</sys:Double>

    <!-- Espaciado -->
    <Thickness x:Key="SpaceXs">3</Thickness>
    <sys:Double x:Key="SpaceXsValue">3</sys:Double>
    <Thickness x:Key="SpaceSm">6</Thickness>
    <sys:Double x:Key="SpaceSmValue">6</sys:Double>
    <Thickness x:Key="SpaceMd">12</Thickness>
    <sys:Double x:Key="SpaceMdValue">12</sys:Double>
    <Thickness x:Key="SpaceLg">16</Thickness>
    <sys:Double x:Key="SpaceLgValue">16</sys:Double>
    <Thickness x:Key="SpaceXl">24</Thickness>
    <sys:Double x:Key="SpaceXlValue">24</sys:Double>

    <!-- Alturas y anchos que dependen del tamaño de letra -->
    <sys:Double x:Key="ControlHeight">36</sys:Double>
    <sys:Double x:Key="RowHeight">36</sys:Double>
    <sys:Double x:Key="TopBarHeight">64</sys:Double>
    <sys:Double x:Key="SidebarWidth">260</sys:Double>

    <!-- Padding interno -->
    <Thickness x:Key="InputPadding">11,8</Thickness>
    <Thickness x:Key="ButtonPadding">18,10</Thickness>
    <Thickness x:Key="SmallButtonPadding">12,6</Thickness>
    <Thickness x:Key="CardPadding">21,19</Thickness>

</ResourceDictionary>
