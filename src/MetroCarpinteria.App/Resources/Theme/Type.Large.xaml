<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ESCALA TIPOGRÁFICA — Grande

        Este diccionario se intercambia en caliente junto con la paleta, así que solo
        contiene valores: sys:Double y Thickness. Ningún estilo.

        El espaciado escala junto con la letra a propósito. Si solo creciera el texto y los
        márgenes quedaran fijos, en tamaño grande los controles se tocarían entre sí y la
        pantalla se vería peor que antes de agrandar.

        Por el mismo motivo, en los XAML las alturas con texto adentro van con MinHeight
        atado a estos valores y no con Height fijo: un Height="20" recorta la letra grande.
    -->

    <!-- Tamaños de letra -->
    <sys:Double x:Key="FontSizeDisplay">34</sys:Double>
    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeSection">19</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">18</sys:Double>
    <sys:Double x:Key="FontSizeBody">17</sys:Double>
    <sys:Double x:Key="FontSizeCaption">14</sys:Double>
    <sys:Double x:Key="FontSizeMicro">13</sys:Double>

    <!-- Espaciado -->
    <Thickness x:Key="SpaceXs">4</Thickness>
    <sys:Double x:Key="SpaceXsValue">4</sys:Double>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <sys:Double x:Key="SpaceSmValue">8</sys:Double>
    <Thickness x:Key="SpaceMd">15</Thickness>
    <sys:Double x:Key="SpaceMdValue">15</sys:Double>
    <Thickness x:Key="SpaceLg">20</Thickness>
    <sys:Double x:Key="SpaceLgValue">20</sys:Double>
    <Thickness x:Key="SpaceXl">30</Thickness>
    <sys:Double x:Key="SpaceXlValue">30</sys:Double>

    <!-- Alturas y anchos que dependen del tamaño de letra -->
    <sys:Double x:Key="ControlHeight">44</sys:Double>
    <sys:Double x:Key="RowHeight">44</sys:Double>
    <sys:Double x:Key="TopBarHeight">78</sys:Double>
    <sys:Double x:Key="SidebarWidth">300</sys:Double>

    <!-- Padding interno -->
    <Thickness x:Key="InputPadding">13,10</Thickness>
    <Thickness x:Key="ButtonPadding">22,13</Thickness>
    <Thickness x:Key="SmallButtonPadding">15,8</Thickness>
    <Thickness x:Key="CardPadding">26,23</Thickness>

</ResourceDictionary>
