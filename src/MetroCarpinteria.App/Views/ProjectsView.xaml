<UserControl x:Class="MetroCarpinteria.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:entities="clr-namespace:MetroCarpinteria.App.Data.Entities"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <Grid x:Name="PageRoot" Background="{StaticResource ContentBackgroundBrush}" Opacity="0">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Proyectos" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Trabajos del taller, materiales y personal asignado."
                           Style="{StaticResource SubtitleStyle}" Margin="0,0,0,16" />
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="+ Nuevo proyecto" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewProjectCommand}" Margin="0,0,10,8" />
                    <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditProjectCommand}" Margin="0,0,10,8" />
                    <Button Content="Archivar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ArchiveProjectCommand}" Margin="0,0,10,8" />
                    <Button Content="Restaurar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RestoreProjectCommand}" Margin="0,0,10,8" />
                    <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteProjectCommand}" Margin="0,0,10,8" />
                    <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" Margin="0,0,10,8" />
                </WrapPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,10" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Label" Padding="8,8" Margin="0,0,12,0" />
                    <CheckBox Grid.Column="2" Content="Ver archivados" IsChecked="{Binding ShowArchived}"
                              VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>
                <Border CornerRadius="8" Padding="12,8"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A4A7C59" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Background" Value="#1AC45C26" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              BorderThickness="0" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proyecto" Binding="{Binding Title}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClientName}" Width="120" />
                            <DataGridTemplateColumn Header="Estado" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrownBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Presupuesto" Binding="{Binding BudgetDisplay}" Width="100" />
                            <DataGridTextColumn Header="Mat." Binding="{Binding MaterialCount}" Width="50" />
                            <DataGridTextColumn Header="Pers." Binding="{Binding AssignmentCount}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FormHeader}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                                <TextBlock Text="Título" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <TextBlock Text="Cliente" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormClientName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <TextBlock Text="Descripción" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" MinHeight="60"
                                         TextWrapping="Wrap" AcceptsReturn="True" />
                                <TextBlock Text="Presupuesto (opcional)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormBudget, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <TextBlock Text="Estado" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding FormStatusOptions}" SelectedItem="{Binding FormStatus}"
                                          DisplayMemberPath="Label" Padding="8,8" Margin="0,0,0,16" />
                                <WrapPanel>
                                    <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SaveProjectCommand}" Margin="0,0,10,0" />
                                    <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CancelFormCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Asignar material" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource SubtitleStyle}" Margin="0,0,0,12" TextWrapping="Wrap"
                                           Text="Descuenta stock del inventario automáticamente." />
                                <TextBlock Text="Producto" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}"
                                          DisplayMemberPath="Name" Padding="8,8" Margin="0,0,0,12" />
                                <TextBlock Text="Cantidad" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MaterialQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <Button Content="Asignar material" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AssignMaterialCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Materiales del proyecto" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Materials}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectMaterialItem}">
                                            <Border Padding="0,6" BorderBrush="#1A3D2914" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                                    <TextBlock>
                                                        <Run Text="{Binding QuantityDisplay, Mode=OneWay}" />
                                                        <Run Text=" · " Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <Run Text="{Binding AssignedAtLocal, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}"
                                                             Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Asignar personal" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="Empleado" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableEmployees}" SelectedItem="{Binding SelectedEmployee}"
                                          DisplayMemberPath="FullName" Padding="8,8" Margin="0,0,0,12" />
                                <TextBlock Text="Notas (opcional)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AssignmentNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <Button Content="Asignar" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AssignEmployeeCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Personal asignado" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Assignments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectAssignmentItem}">
                                            <Border Padding="0,8" BorderBrush="#1A3D2914" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding EmployeeRole}" Style="{StaticResource SubtitleStyle}" />
                                                        <TextBlock Text="{Binding AssignedAtLocal, StringFormat=dd/MM/yyyy HH:mm}"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4" FontSize="11"
                                                            Command="{Binding DataContext.RemoveAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
