<UserControl x:Class="MetroCarpinteria.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:entities="clr-namespace:MetroCarpinteria.App.Data.Entities"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:MetroCarpinteria.App.Controls"
             xmlns:quotes="clr-namespace:MetroCarpinteria.App.Views.Quotes"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <Grid x:Name="PageRoot" Background="{DynamicResource ContentBackgroundBrush}" Opacity="0">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Proyectos" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Trabajos del taller, materiales y personal asignado."
                           Style="{StaticResource SubtitleStyle}" Margin="0,0,0,16" />
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="+ Nuevo proyecto" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewProjectCommand}" Margin="0,0,10,8" />
                    <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditProjectCommand}" Margin="0,0,10,8" />
                    <!-- Los tres pasos del taller. Se ocultan en vez de agrisarse: sobre un
                         trabajo listo, «Iniciar trabajo» gris no aporta nada y una barra con
                         seis botones muertos hace más ruido que una con dos vivos. -->
                    <Button Content="Iniciar trabajo" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding StartWorkCommand}" Margin="0,0,10,8"
                            Visibility="{Binding CanStartWork, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="El trabajo pasa de aprobado a en taller" />
                    <Button Content="Marcar listo" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding MarkReadyCommand}" Margin="0,0,10,8"
                            Visibility="{Binding CanMarkReady, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="El trabajo queda terminado y deja de contar como atrasado" />
                    <Button Content="Seguir en taller" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BackToWorkshopCommand}" Margin="0,0,10,8"
                            Visibility="{Binding CanBackToWorkshop, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Vuelve al taller un trabajo que se marcó listo por error" />
                    <Button Content="Cancelar trabajo" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelProjectCommand}" Margin="0,0,10,8"
                            ToolTip="Vuelve el trabajo a presupuesto y devuelve los materiales al inventario" />
                    <Button Content="Archivar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ArchiveProjectCommand}" Margin="0,0,10,8" />
                    <Button Content="Restaurar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RestoreProjectCommand}" Margin="0,0,10,8" />
                    <!-- ShowOnDisabled: el tooltip explica justamente por qué está gris,
                         y sin esto es lo único que WPF no muestra. -->
                    <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteProjectCommand}" Margin="0,0,10,8"
                            ToolTip="{Binding DeleteBlockTooltip}"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" Margin="0,0,10,8" />
                </WrapPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,10" Margin="0,0,12,0"
                             ctl:Ui.IsSectionSearchBox="True"
                             ctl:Ui.Placeholder="Buscar por trabajo o cliente…"
                             AutomationProperties.Name="Buscar proyecto"
                             ToolTip="Buscar por trabajo o cliente (Ctrl+F)" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Label" Padding="8,8" Margin="0,0,12,0" />
                    <CheckBox Grid.Column="2" Content="Ver archivados" IsChecked="{Binding ShowArchived}"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <!-- Sin toast al abrir: un aviso que hay que cerrar todos los días se vuelve
                     un trámite. Esto se queda mientras haya algo atrasado y desaparece solo
                     cuando se marca listo. -->
                <Border Background="{DynamicResource StateWarningSurfaceBrush}"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                        Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding OverdueBannerText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AlertBrush}" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                              BorderThickness="0"
                              ctl:Ui.EmptyIcon="🪚"
                              ctl:Ui.EmptyTitle="Ningún trabajo en curso"
                              ctl:Ui.EmptyMessage="Los proyectos aparecen acá al aprobar un presupuesto. También podés crear uno a mano.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Proyecto" Binding="{Binding Title}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClientName}" Width="120" />
                            <DataGridTemplateColumn Header="Estado" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrownBrush}" />
                                            <!-- El atraso va debajo del estado y no en lugar
                                                 de él: saber que está atrasado no sirve si
                                                 no se ve si está esperando o ya en el banco. -->
                                            <TextBlock Text="{Binding OverdueDisplay}" FontSize="11" FontWeight="SemiBold"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource AlertBrush}"
                                                       Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Presupuesto" Binding="{Binding BudgetDisplay}" Width="100" />
                            <DataGridTextColumn Header="Mat." Binding="{Binding MaterialCount}" Width="50" />
                            <DataGridTextColumn Header="Pers." Binding="{Binding AssignmentCount}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FormHeader}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
                                <TextBlock Text="Título" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <TextBlock Text="Cliente" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormClientName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <TextBlock Text="Descripción" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" MinHeight="60"
                                         TextWrapping="Wrap" AcceptsReturn="True" />
                                <TextBlock Text="Presupuesto (opcional)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormBudget, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <!-- Solo en el alta: anotar un trabajo que ya venía andando no
                                     es una transición. Al editar el estado lo mueven los
                                     botones del taller, que son los que respetan el ciclo. -->
                                <StackPanel Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Estado" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding FormStatusOptions}" SelectedItem="{Binding FormStatus}"
                                              DisplayMemberPath="Label" Padding="8,8" Margin="0,0,0,16" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SaveProjectCommand}" Margin="0,0,10,0" />
                                    <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CancelFormCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Presupuesto que originó el proyecto (solo lectura) -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Presupuesto original" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding QuoteIssuedDisplay}" Style="{StaticResource SubtitleStyle}"
                                           Margin="0,2,0,12" />

                                <ItemsControl ItemsSource="{Binding QuoteLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:BudgetBreakdownLine}">
                                            <Grid Margin="0,3">
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding AmountDisplay}" HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,12,0,0">
                                    <TextBlock Text="Precio final" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding QuoteFinalPriceDisplay}" HorizontalAlignment="Right"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrownBrush}" />
                                </Grid>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Imprimir presupuesto" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6" FontSize="12" Margin="0,0,10,0"
                                            Command="{Binding PrintQuoteCommand}" />
                                    <Button Content="Guardar PDF" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6" FontSize="12"
                                            Command="{Binding SaveQuotePdfCommand}"
                                            ToolTip="Guarda el presupuesto como archivo, para mandarlo por mensaje" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- El trabajo en curso también cobra: es el mismo bloque de
                             Presupuestos, con su propio ViewModel. -->
                        <quotes:QuotePaymentsPanel DataContext="{Binding PaymentsSection}" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Asignar material" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource SubtitleStyle}" Margin="0,0,0,12" TextWrapping="Wrap"
                                           Text="Descuenta stock del inventario automáticamente." />
                                <TextBlock Text="Producto" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedProduct}"
                                          DisplayMemberPath="Name" Padding="8,8" Margin="0,0,0,12" />
                                <TextBlock Text="Cantidad" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MaterialQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <Button Content="Asignar material" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AssignMaterialCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Materiales del proyecto" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Materials}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectMaterialItem}">
                                            <Border Padding="0,8" BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                                        <TextBlock>
                                                            <Run Text="{Binding QuantityDisplay, Mode=OneWay}" />
                                                            <Run Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <Run Text="{Binding AssignedAtLocal, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4" FontSize="11"
                                                            ToolTip="Quitar y devolver al inventario"
                                                            Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Asignar personal" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="Empleado" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableEmployees}" SelectedItem="{Binding SelectedEmployee}"
                                          DisplayMemberPath="FullName" Padding="8,8" Margin="0,0,0,12" />
                                <TextBlock Text="Notas (opcional)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AssignmentNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <Button Content="Asignar" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AssignEmployeeCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Personal asignado" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Assignments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectAssignmentItem}">
                                            <Border Padding="0,8" BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding EmployeeRole}" Style="{StaticResource SubtitleStyle}" />
                                                        <TextBlock Text="{Binding PaymentStatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource PrimaryBrownBrush}" />
                                                        <TextBlock Text="{Binding AssignedAtLocal, StringFormat=dd/MM/yyyy HH:mm}"
                                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                        <Button Content="{Binding TogglePaymentLabel}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="8,4" FontSize="11" Margin="0,0,0,6" HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.ToggleAssignmentPaidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="✕" HorizontalAlignment="Right"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="8,4" FontSize="11"
                                                                Command="{Binding DataContext.RemoveAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
