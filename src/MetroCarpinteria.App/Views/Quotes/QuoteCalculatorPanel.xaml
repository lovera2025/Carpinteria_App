<UserControl x:Class="MetroCarpinteria.App.Views.Quotes.QuoteCalculatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="520">

    <!-- Paso 2 del presupuesto: qué sale el trabajo. Entradas, porcentajes, desglose y el
         ajuste manual del precio final. El DataContext se hereda del contenedor, así que
         las rutas de binding son las mismas que cuando esto vivía dentro de QuotesView. -->
    <StackPanel>
        <!-- Paso 2: precio -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Background="{DynamicResource PrimaryBrownBrush}" CornerRadius="11"
                            Width="22" Height="22" Margin="0,0,10,0">
                        <TextBlock Text="2" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnDarkBrush}" />
                    </Border>
                    <TextBlock Text="PRECIO" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <TextBlock Text="{Binding PriceStepSummary}" Margin="32,0,0,12"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryBrownBrush}" />

                <TextBlock Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="El precio se actualiza solo a medida que cargás los datos." />

                <TextBlock Text="Costo de materiales" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                <TextBox Padding="10,8" Margin="0,0,0,4"
                         Text="{Binding CalcMaterials, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Sale solo de los materiales cargados arriba. Se puede sobrescribir." />
                <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="11" Margin="0,0,0,12"
                           Text="Se toma solo de los materiales del paso 1." />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Días del jefe" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CalcDays, UpdateSourceTrigger=LostFocus}" Padding="10,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Jornal del jefe" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CalcDailyRate, UpdateSourceTrigger=LostFocus}" Padding="10,8" />
                    </StackPanel>
                </Grid>

                <Expander Header="{Binding RatesSummary}" IsExpanded="{Binding IsAdvancedOpen}"
                          Foreground="{DynamicResource PrimaryBrownBrush}" Margin="0,0,0,16">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Los porcentajes se aplican sobre materiales (desperdicio y desgaste) y sobre la mano de obra (gastos y ganancia)." />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="% Desperdicio" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding RateWaste, UpdateSourceTrigger=LostFocus}" Padding="10,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="% Desgaste de herramientas" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding RateToolWear, UpdateSourceTrigger=LostFocus}" Padding="10,8" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="% Gastos adicionales" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding RateOverhead, UpdateSourceTrigger=LostFocus}" Padding="10,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="% Ganancia" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding RateProfit, UpdateSourceTrigger=LostFocus}" Padding="10,8" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel>
                            <Button Content="Guardar como valores por defecto"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,6" FontSize="12" Margin="0,0,10,8"
                                    Command="{Binding SaveDefaultRatesCommand}" />
                            <Button Content="Restaurar valores recomendados"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,6" FontSize="12" Margin="0,0,0,8"
                                    Command="{Binding RestoreDefaultRatesCommand}"
                                    ToolTip="{Binding RestoreRatesTooltip}" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>

                <Button Content="Recalcular" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left" Command="{Binding CalculateCommand}"
                        ToolTip="El precio ya se actualiza solo. Esto lo fuerza a mano." />
            </StackPanel>
        </Border>

        <!-- Operarios: quiénes trabajan además del jefe. Cada uno con sus días y su jornal,
             porque no todos cobran lo mismo ni están la misma cantidad de días. -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="OPERARIOS" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Content="+ Agregar operario" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6" FontSize="12"
                            Command="{Binding AddLaborLineCommand}" />
                </Grid>

                <TextBlock Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Se eligen de Personal. El jornal viene de la ficha y se puede cambiar solo para este presupuesto." />

                <ItemsControl ItemsSource="{Binding LaborLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:QuoteLaborLineItem}">
                            <Border Padding="0,8" BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding SummaryDisplay}" FontSize="12" Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding LineTotalDisplay}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="12,0,8,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                            ToolTip="Quitar de la mano de obra"
                                            Command="{Binding DataContext.RemoveLaborLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="Todavía no cargaste operarios: la mano de obra es solo la del jefe."
                           Visibility="{Binding HasLaborLines, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                <Grid Margin="0,12,0,0">
                    <TextBlock Text="Mano de obra total" Style="{StaticResource SubtitleStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LaborTotalDisplay}" HorizontalAlignment="Right"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Alta de operario -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                Visibility="{Binding IsLaborFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Agregar operario" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                <TextBlock Text="Operario" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailableWorkers}" SelectedItem="{Binding SelectedWorker}"
                          DisplayMemberPath="PickerDisplay" Padding="8,8" Margin="0,0,0,4"
                          ToolTip="Elegí a alguien de Personal, o dejalo vacío y escribí el nombre abajo" />

                <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="11" Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Text="No hay nadie cargado en Personal todavía. Escribí el nombre abajo."
                           Visibility="{Binding HasAvailableWorkers, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                <!-- Alguien que no está dado de alta: un changarín por una semana no
                     obliga a crearle un legajo. -->
                <StackPanel Visibility="{Binding IsLooseWorker, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Nombre" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding LooseWorkerName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="11" Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Text="Al no estar en Personal, no queda asignado al proyecto cuando aprobás." />
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Días" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding WorkerDays, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Jornal" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding WorkerDailyRate, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" />
                    </StackPanel>
                </Grid>

                <!-- Total de la línea antes de confirmar, para no cargar a ciegas. -->
                <Border Background="{DynamicResource BrandAccentSubtleBrush}" CornerRadius="8"
                        Padding="12,10" Margin="0,0,0,14">
                    <Grid>
                        <TextBlock Text="Total de esta línea" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Text="{Binding WorkerLineTotalDisplay}" HorizontalAlignment="Right"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrownBrush}" />
                    </Grid>
                </Border>

                <WrapPanel>
                    <Button Content="Agregar" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ConfirmWorkerCommand}" Margin="0,0,10,0" />
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelWorkerCommand}" />
                </WrapPanel>

                <TextBlock Text="Elegí a alguien de la lista o escribí un nombre para poder agregarlo."
                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding CanConfirmWorker, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
            </StackPanel>
        </Border>

        <!-- Desglose -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Desglose" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding BreakdownLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BudgetBreakdownLine}">
                            <Grid Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding Detail, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AmountDisplay}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Redondear para cerrar la venta sin tocar el cálculo. -->
                <Border BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="0,1,0,0"
                        Margin="0,14,0,0" Padding="0,14,0,0"
                        Visibility="{Binding CanAdjustPrice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Precio final ajustado" Style="{StaticResource SubtitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Text="Es el número que se le cobra al cliente y el que sale impreso. El desglose no cambia." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Padding="10,8"
                                     Text="{Binding AdjustedPrice, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Fijar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8"
                                    Command="{Binding ApplyAdjustedPriceCommand}" />
                        </Grid>
                        <Button Content="Volver al calculado" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left" Padding="12,6" FontSize="12" Margin="0,10,0,0"
                                Command="{Binding RestoreCalculatedPriceCommand}"
                                Visibility="{Binding ShowManualAdjustNotice, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{Binding Detail.Commercial.TotalDisplay, StringFormat=Vuelve a {0}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Condiciones comerciales: plegado por default porque la mayoría de los
             presupuestos del taller no llevan IVA discriminado. El encabezado dice qué se
             pactó, así no hace falta abrirlo para saberlo. -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                Visibility="{Binding CanEditCommercialTerms, Converter={StaticResource BoolToVisibilityConverter}}">
            <Expander Header="{Binding CommercialSummary}" IsExpanded="{Binding IsCommercialOpen}"
                      Foreground="{DynamicResource PrimaryBrownBrush}">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Se aplican sobre el precio calculado y no cambian el desglose. El descuento se resta primero y el IVA se calcula sobre lo que queda." />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IVA" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding VatOptions}" SelectedItem="{Binding SelectedVat}"
                                      DisplayMemberPath="Label" Padding="8,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding IsCustomVat, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Alícuota (%)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CustomVatPercent, UpdateSourceTrigger=LostFocus}" Padding="10,8" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Descuento" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding DiscountModeOptions}"
                                      SelectedItem="{Binding SelectedDiscountMode}"
                                      DisplayMemberPath="Label" Padding="8,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding HasDiscountMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding DiscountValueLabel}" Style="{StaticResource SubtitleStyle}"
                                       Margin="0,0,0,4" />
                            <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=LostFocus}" Padding="10,8" />
                        </StackPanel>
                    </Grid>

                    <!-- El pie tal como va a salir impreso. -->
                    <Border Background="{DynamicResource BrandAccentSubtleBrush}" CornerRadius="8"
                            Padding="14,12" Margin="0,4,0,0"
                            Visibility="{Binding HasCommercialTerms, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding CommercialLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:BudgetBreakdownLine}">
                                        <Grid Margin="0,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding Detail, Converter={StaticResource StringToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding AmountDisplay}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </Border>
    </StackPanel>
</UserControl>
