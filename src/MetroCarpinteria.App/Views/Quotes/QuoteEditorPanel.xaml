<UserControl x:Class="MetroCarpinteria.App.Views.Quotes.QuoteEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="520">

    <!-- Cabecera del presupuesto: el formulario de alta y edición, el estado sin selección
         y la ficha del presupuesto abierto. El DataContext se hereda del contenedor, así
         que las rutas de binding son las mismas que cuando esto vivía dentro de QuotesView. -->
    <StackPanel>
        <!-- Formulario de cabecera -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding FormHeader}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
                <TextBlock Text="Trabajo" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" Margin="0,0,0,12" />
                <TextBlock Text="Cliente" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FormClientName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" Margin="0,0,0,4"
                         ToolTip="Escribí el nombre. La ficha se crea o se reusa sola al guardar." />

                <!-- Se ofrecen las fichas que ya existen, pero el campo sigue siendo texto
                     libre: obligar a dar de alta un cliente antes de cotizar rompe el
                     flujo del taller. -->
                <ItemsControl ItemsSource="{Binding ClientSuggestions}" Margin="0,0,0,12"
                              Visibility="{Binding HasClientSuggestions, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ClientListItem}">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6" Margin="0,4,0,0" FontSize="12"
                                    Command="{Binding DataContext.PickClientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding HistoryDisplay}" FontSize="10" Opacity="0.8" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormClientPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 ToolTip="Queda en la ficha del cliente. No sale en el PDF." />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormClientEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8"
                                 ToolTip="Queda en la ficha del cliente. No sale en el PDF." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Descripción (opcional)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" Margin="0,0,0,12" MinHeight="56"
                         TextWrapping="Wrap" AcceptsReturn="True" />
                <TextBlock Text="Válido hasta" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                <DatePicker SelectedDate="{Binding FormValidUntil}" Margin="0,0,0,16" Padding="6,6" />
                <WrapPanel>
                    <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveQuoteCommand}" Margin="0,0,10,0" />
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelFormCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Sin selección -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
            <StackPanel>
                <TextBlock Text="Ningún presupuesto seleccionado" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap"
                           Text="Creá uno nuevo o elegí uno de la lista. La calculadora de abajo funciona igual para hacer una cuenta rápida." />
            </StackPanel>
        </Border>

        <!-- Cabecera del presupuesto -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding Detail.Title}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0">
                    <Run Text="Cliente: " Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Run Text="{Binding Detail.ClientName, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding DetailStatusLabel}" Style="{StaticResource SubtitleStyle}"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail.Description}" Style="{StaticResource SubtitleStyle}"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Detail.Description, Converter={StaticResource StringToVisibilityConverter}}" />

                <Border CornerRadius="8" Padding="10,8" Margin="0,12,0,0" Background="{DynamicResource BrandAccentSubtleBrush}"
                        Visibility="{Binding ShowManualAdjustNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="El precio final fue ajustado a mano y no coincide con el cálculo."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryBrownBrush}" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
