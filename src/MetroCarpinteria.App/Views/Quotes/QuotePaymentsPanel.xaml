<UserControl x:Class="MetroCarpinteria.App.Views.Quotes.QuotePaymentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="520">

    <!-- Señas y pagos a cuenta. Lo que el taller mira acá es una sola cosa —cuánto falta
         cobrar—, así que el saldo va grande y arriba de todo. El DataContext se hereda del
         contenedor. -->
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="COBROS" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Content="+ Registrar cobro" HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,6" FontSize="12"
                        Command="{Binding OpenFormCommand}"
                        ToolTip="Seña, pago a cuenta o saldo final" />
            </Grid>

            <TextBlock Text="{Binding Summary}" Margin="0,0,0,12"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrownBrush}" />

            <!-- El saldo, que es el número por el que se abre esta tarjeta. -->
            <Border Background="{DynamicResource BrandAccentSubtleBrush}" CornerRadius="8"
                    Padding="14,12" Margin="0,0,0,12"
                    Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding BalanceLabel}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="0,3,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Entregado: " />
                            <Run Text="{Binding PaidTotalDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding BalanceDisplay}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrownBrush}" />
                </Grid>
            </Border>

            <!-- Formulario de cobro -->
            <Border BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="0,1,0,0"
                    Padding="0,14,0,0" Margin="0,0,0,4"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Concepto" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PaymentKinds}" SelectedItem="{Binding PaymentKind}"
                                      DisplayMemberPath="Label" Padding="8,8" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Medio de pago" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}"
                                      DisplayMemberPath="Label" Padding="8,8" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Importe" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" Margin="0,0,0,4"
                             ToolTip="Viene propuesto el saldo completo" />
                    <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="11" Margin="0,0,0,12"
                               Text="No se puede cobrar más que el saldo." />

                    <TextBlock Text="Notas (opcional)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" Margin="0,0,0,12" />

                    <WrapPanel>
                        <Button Content="Registrar cobro" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ConfirmCommand}" Margin="0,0,10,0" />
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelFormCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Lo ya cobrado -->
            <ItemsControl ItemsSource="{Binding Payments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ProjectPaymentItem}">
                        <!-- Un cobro anulado se queda en la lista: es parte de la historia
                             del trabajo y el cliente puede preguntar por él. Pero tiene que
                             leerse como anulado de un vistazo, no por un texto chiquito:
                             apagado, tachado y sin los botones de anular ni de imprimir el
                             recibo. Un comprobante de plata que se devolvió es lo último
                             que se le puede dar a un cliente. -->
                        <Border Padding="0,8" BorderBrush="{DynamicResource BorderBrushToken}"
                                BorderThickness="0,0,0,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Notes}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding CancelNote}" FontSize="11" TextWrapping="Wrap"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding CancelNote, Converter={StaticResource StringToVisibilityConverter}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Margin="12,0,8,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsCancelled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                    <Button Content="Recibo" VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                            ToolTip="Abre el PDF de este cobro"
                                            Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="✕" VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,4" FontSize="11"
                                            ToolTip="Anular este cobro"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
