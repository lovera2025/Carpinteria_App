<UserControl x:Class="MetroCarpinteria.App.Views.Quotes.QuoteListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:MetroCarpinteria.App.Controls"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="420">

    <!-- El DataContext se hereda del contenedor, así que las rutas de binding son las
         mismas que cuando esto vivía dentro de QuotesView. -->
    <Border Style="{StaticResource CardStyle}" Padding="0">
        <DataGrid ItemsSource="{Binding Quotes}" SelectedItem="{Binding SelectedQuote}" BorderThickness="0"
                  Background="Transparent"
                  ctl:Ui.EmptyIcon="🧮"
                  ctl:Ui.EmptyTitle="Ningún presupuesto todavía"
                  ctl:Ui.EmptyMessage="Empezá con «+ Nuevo presupuesto». Cargar materiales no toca el inventario: el stock se descuenta recién cuando el cliente acepta.">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cliente" Binding="{Binding ClientName}" Width="130" />
                <DataGridTextColumn Header="Trabajo" Binding="{Binding Title}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Total" Binding="{Binding BudgetDisplay}" Width="110" />
                <DataGridTemplateColumn Header="Estado" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:QuoteListItem}">
                            <StackPanel Margin="4,2">
                                <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Vigente -->
                                            <Setter Property="Background" Value="{DynamicResource StateSuccessSurfaceBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Freshness}" Value="{x:Static models:QuoteFreshness.DueSoon}">
                                                    <Setter Property="Background" Value="{DynamicResource BrandAccentSubtleBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Freshness}" Value="{x:Static models:QuoteFreshness.Expired}">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource StateWarningSurfaceBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding FreshnessLabel}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Freshness}" Value="{x:Static models:QuoteFreshness.DueSoon}">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrownBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Freshness}" Value="{x:Static models:QuoteFreshness.Expired}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                        <Setter Property="Text" Value="Rechazado" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AlertBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding AgeDisplay}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="2,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</UserControl>
