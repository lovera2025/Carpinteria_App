<UserControl x:Class="MetroCarpinteria.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <Grid x:Name="PageRoot"
          Background="{StaticResource ContentBackgroundBrush}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="24,20,24,12">
            <StackPanel>
                <TextBlock Text="Inventario"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Productos, stock y movimientos del taller."
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,16" />

                <WrapPanel Margin="0,0,0,12">
                    <Button Content="+ Nuevo producto"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewProductCommand}"
                            Margin="0,0,10,8" />
                    <Button Content="Editar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditProductCommand}"
                            Margin="0,0,10,8" />
                    <Button Content="Archivar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ArchiveProductCommand}"
                            Margin="0,0,10,8" />
                    <Button Content="Restaurar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RestoreProductCommand}"
                            Margin="0,0,10,8" />
                    <Button Content="Eliminar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteProductCommand}"
                            Margin="0,0,10,8" />
                    <Button Content="Actualizar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}"
                            Margin="0,0,10,8" />
                </WrapPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,10"
                             Margin="0,0,12,0"
                             Background="White"
                             BorderBrush="#333D2914"
                             Tag="Buscar producto..." />
                    <CheckBox Grid.Column="1"
                              Content="Solo alertas"
                              IsChecked="{Binding LowStockOnly}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                    <CheckBox Grid.Column="2"
                              Content="Ver archivados"
                              IsChecked="{Binding ShowArchived}"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>

                <!-- Status -->
                <Border CornerRadius="8"
                        Padding="12,8"
                        Margin="0,12,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A4A7C59" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Background" Value="#1AC45C26" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Product list -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#08F5F0E8"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockDisplay}" Width="100" />
                        <DataGridTextColumn Header="Mínimo" Binding="{Binding MinimumDisplay}" Width="90" />
                        <DataGridTemplateColumn Header="Estado" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:ProductListItem}">
                                    <Border CornerRadius="8"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Margin="4,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1A4A7C59" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ProductStockStatus.Low}">
                                                        <Setter Property="Background" Value="#1AC45C26" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ProductStockStatus.Out}">
                                                        <Setter Property="Background" Value="#33C45C26" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ProductStockStatus.Low}">
                                                            <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ProductStockStatus.Out}">
                                                            <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Right panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Product form -->
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,16" />
                            <TextBlock Text="Nombre" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8" Margin="0,0,0,12" />
                            <StackPanel Visibility="{Binding ShowInitialStockField, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Stock inicial" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormInitialStock, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Stock actual" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormCurrentStockDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Padding="10,8"
                                         Margin="0,0,0,12"
                                         Background="#0D3D2914" />
                            </StackPanel>
                            <TextBlock Text="Stock mínimo (alerta)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormMinimumStock, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8" Margin="0,0,0,12" />
                            <TextBlock Text="Unidad" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableUnits}"
                                      SelectedItem="{Binding FormUnit}"
                                      Padding="10,8"
                                      Margin="0,0,0,16" />
                            <WrapPanel>
                                <Button Content="Guardar"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveProductCommand}"
                                        Margin="0,0,10,0" />
                                <Button Content="Cancelar"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CancelFormCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stock movement -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Movimiento de stock"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Margin="0,0,0,16">
                                <Run Text="Producto: " Foreground="{StaticResource TextSecondaryBrush}" />
                                <Run Text="{Binding SelectedProduct.Name, Mode=OneWay, FallbackValue='—'}"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="Entrada"
                                             IsChecked="{Binding MovementIsEntry, Mode=TwoWay}"
                                             GroupName="MovementType"
                                             Margin="0,0,16,0"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                                <RadioButton Content="Salida"
                                             IsChecked="{Binding MovementIsEntry, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                             GroupName="MovementType"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Cantidad" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding MovementQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8" Margin="0,0,0,12" />
                            <TextBlock Text="Motivo" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding MovementReason, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8"
                                     Margin="0,0,0,16"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="60" />
                            <Button Content="Registrar movimiento"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RegisterMovementCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Recent movements -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Historial de movimientos"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,12" />
                            <ListView ItemsSource="{Binding RecentMovements}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      MaxHeight="280">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:StockMovementItem}">
                                        <Border Padding="0,6" BorderBrush="#1A3D2914" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TypeLabel}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrownBrush}"
                                                               Width="60" />
                                                    <TextBlock Text="{Binding QuantityDisplay}"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Reason}"
                                                           Style="{StaticResource SubtitleStyle}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding CreatedAtLocal, StringFormat=dd/MM/yyyy HH:mm}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
