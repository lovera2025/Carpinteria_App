<UserControl x:Class="MetroCarpinteria.App.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:MetroCarpinteria.App.Controls"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <Grid x:Name="PageRoot" Background="{DynamicResource ContentBackgroundBrush}" Opacity="0">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Clientes" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Quién es quién, con lo que se le cotizó y lo que queda por cobrar."
                           Style="{StaticResource SubtitleStyle}" Margin="0,0,0,16" />

                <WrapPanel Margin="0,0,0,12">
                    <Button Content="+ Nuevo cliente" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewClientCommand}" Margin="0,0,10,8" />
                    <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditClientCommand}" Margin="0,0,10,8" />
                    <Button Content="Archivar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ArchiveClientCommand}" Margin="0,0,10,8" />
                    <Button Content="Restaurar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RestoreClientCommand}" Margin="0,0,10,8" />
                    <!-- ShowOnDisabled: el tooltip explica justamente por qué está gris. -->
                    <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteClientCommand}" Margin="0,0,10,8"
                            ToolTip="{Binding DeleteBlockTooltip}"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Content="{Binding DuplicatesButtonLabel}" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleDuplicatesCommand}" Margin="0,0,10,8"
                            ToolTip="Fichas que podrían ser la misma persona" />
                </WrapPanel>

                <Grid Margin="0,0,0,8"
                      Visibility="{Binding IsReviewingDuplicates, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Padding="12,10" Margin="0,0,12,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ctl:Ui.IsSectionSearchBox="True"
                             ctl:Ui.Placeholder="Buscar por nombre…"
                             AutomationProperties.Name="Buscar cliente"
                             ToolTip="Buscar por nombre, con o sin acentos (Ctrl+F)" />
                    <CheckBox Grid.Column="1" Content="Ver archivados" IsChecked="{Binding ShowArchived}"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
            </StackPanel>

            <!-- Lista y ficha -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsReviewingDuplicates, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                              BorderThickness="0" Background="Transparent"
                              ctl:Ui.EmptyIcon="👥"
                              ctl:Ui.EmptyTitle="Todavía no hay clientes"
                              ctl:Ui.EmptyMessage="Se dan de alta solos al cotizar: escribí el nombre en el presupuesto y la ficha se crea.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Name}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Trabajos" Binding="{Binding QuoteCount}" Width="80" />
                            <DataGridTextColumn Header="Facturado" Binding="{Binding InvoicedDisplay}" Width="120" />
                            <DataGridTemplateColumn Header="Saldo" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ClientListItem}">
                                        <TextBlock Text="{Binding BalanceDisplay}" FontWeight="SemiBold"
                                                   Margin="4,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBalance}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AlertBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Formulario -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FormHeader}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                                <TextBlock Text="Nombre" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Teléfono" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CUIT / CUIL" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding FormTaxId, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,8" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Email" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />

                                <TextBlock Text="Dirección" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />

                                <TextBlock Text="Notas" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,16" MinHeight="56"
                                         TextWrapping="Wrap" AcceptsReturn="True" />

                                <WrapPanel>
                                    <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SaveClientCommand}" Margin="0,0,10,0" />
                                    <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CancelFormCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ficha -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedClient.Name}" FontSize="17" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedClient.ContactDisplay}"
                                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedClient.HistoryDisplay}"
                                           Style="{StaticResource SubtitleStyle}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedClient.Notes}" TextWrapping="Wrap"
                                           Style="{StaticResource SubtitleStyle}" Margin="0,8,0,0"
                                           Visibility="{Binding SelectedClient.Notes, Converter={StaticResource StringToVisibilityConverter}}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource BrandAccentSubtleBrush}"
                                            CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="FACTURADO" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedClient.InvoicedDisplay}"
                                                       FontSize="17" FontWeight="Bold" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource PrimaryBrownBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource BrandAccentSubtleBrush}"
                                            CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="SALDO A COBRAR" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedClient.BalanceDisplay}"
                                                       FontSize="17" FontWeight="Bold" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource PrimaryBrownBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Historial -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Historial de trabajos" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ClientProjectItem}">
                                            <Border Padding="0,8" BorderBrush="{DynamicResource BorderBrushToken}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Margin="0,2,0,0" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding DateDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BudgetDisplay}"
                                                                   HorizontalAlignment="Right" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock HorizontalAlignment="Right" FontSize="11"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource AlertBrush}"
                                                                   Visibility="{Binding HasBalance, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Run Text="Debe " />
                                                            <Run Text="{Binding BalanceDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Revisión de duplicados -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsReviewingDuplicates, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DuplicatesSummary}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Style="{StaticResource SubtitleStyle}" />

                    <ItemsControl ItemsSource="{Binding Duplicates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ClientDuplicateCandidate}">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Reason}" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,12"
                                                   Foreground="{DynamicResource PrimaryBrownBrush}" />

                                        <!-- Los dos lados con su historial: es lo que hace falta
                                             para decidir si son la misma persona o padre e hijo. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}"
                                                    CornerRadius="8" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Left.Name}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Left.ContactDisplay}" FontSize="11"
                                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Left.HistoryDisplay}" FontSize="11"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Left.InvoicedDisplay}" FontSize="13"
                                                               FontWeight="SemiBold" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Background="{DynamicResource SurfaceSunkenBrush}"
                                                    CornerRadius="8" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Right.Name}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Right.ContactDisplay}" FontSize="11"
                                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Right.HistoryDisplay}" FontSize="11"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Right.InvoicedDisplay}" FontSize="13"
                                                               FontWeight="SemiBold" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="Es el mismo cliente"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="14,8" Margin="0,0,10,0"
                                                    Command="{Binding DataContext.MergeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Fusiona las dos fichas en una" />
                                            <Button Content="Son distintos"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="14,8"
                                                    Command="{Binding DataContext.DismissPairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="No se vuelve a proponer este par" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
