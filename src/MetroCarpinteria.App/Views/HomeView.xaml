<UserControl x:Class="MetroCarpinteria.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MetroCarpinteria.App.Controls"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid>
        <controls:AnimatedBackground />

        <ScrollViewer x:Name="PageRoot"
                      VerticalScrollBarVisibility="Auto"
                      Padding="32,24"
                      Opacity="0">
            <StackPanel MaxWidth="1100">
                <!-- Hero -->
                <Border CornerRadius="20"
                        Margin="0,0,0,28"
                        ClipToBounds="True"
                        Height="200">
                    <Grid>
                        <Image Source="pack://application:,,,/MetroCarpinteria;component/Assets/banner.jpeg"
                               Stretch="UniformToFill"
                               Opacity="0.85" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#CC1A1614" Offset="0" />
                                    <GradientStop Color="#661A1614" Offset="0.6" />
                                    <GradientStop Color="#331A1614" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel VerticalAlignment="Center"
                                    Margin="36,0"
                                    MaxWidth="520">
                            <Image Source="pack://application:,,,/MetroCarpinteria;component/Assets/logo-horizontal.jpeg"
                                   Height="56"
                                   HorizontalAlignment="Left"
                                   Stretch="Uniform" />
                            <TextBlock Text="{Binding WelcomeMessage}"
                                       Foreground="{DynamicResource TextOnDarkBrush}"
                                       FontSize="18"
                                       Margin="0,16,0,4"
                                       Opacity="0.95" />
                            <TextBlock Text="{Binding ContactInfo}"
                                       Foreground="{DynamicResource AccentGoldLightBrush}"
                                       FontSize="13"
                                       Opacity="0.9" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Primeros pasos. Nunca modal, siempre salteable, y se puede volver a
                     ver desde Configuración: quien ya sabe usar la app la cierra y no la
                     vuelve a ver, y a quien recién empieza no se le esconde. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24"
                        Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Cómo se usa, en cuatro pasos" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button Content="Ya lo sé" HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,6" FontSize="12"
                                    Command="{Binding DismissOnboardingCommand}"
                                    ToolTip="Se puede volver a ver desde Configuración" />
                        </Grid>

                        <TextBlock Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,0,0,14"
                                   Text="El recorrido de un trabajo, de punta a punta." />

                        <ItemsControl ItemsSource="{Binding OnboardingSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource PrimaryBrownBrush}"
                                                CornerRadius="12" Width="24" Height="24"
                                                VerticalAlignment="Top" Margin="0,2,12,0">
                                            <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextOnDarkBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Margin="0,2,0,0" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="11" Margin="0,4,0,0"
                                   Text="Ctrl + / muestra los atajos de teclado." />
                    </StackPanel>
                </Border>

                <!-- Dashboard cards -->
                <TextBlock Text="Resumen del día"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,0,0,16" />

                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="0,0,16,16"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.02"
                                                                 Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.02"
                                                                 Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1"
                                                                 Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1"
                                                                 Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Ellipse.Fill>
                                                <Binding Path="AccentColor" Converter="{StaticResource StringToBrushConverter}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource SubtitleStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Quick actions -->
                <TextBlock Text="Accesos rápidos"
                           Style="{StaticResource PageTitleStyle}"
                           FontSize="22"
                           Margin="0,12,0,16" />

                <!-- Los tres estaban deshabilitados con tooltips de un plan por partes
                     que hace rato se terminó. Ahora navegan a la sección que prometían. -->
                <WrapPanel>
                    <Button Content="Armar un presupuesto"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,12,12"
                            ToolTip="Ir a Presupuestos para cotizar un trabajo"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static models:NavigationSection.Quotes}" />
                    <Button Content="Registrar stock"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,12,12"
                            ToolTip="Ir a Inventario para cargar entradas o salidas"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static models:NavigationSection.Inventory}" />
                    <Button Content="Abrir caja"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,12,12"
                            ToolTip="Ir a Caja para abrir o cerrar la sesión del día"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static models:NavigationSection.CashRegister}" />
                    <Button Content="Nuevo proyecto"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,12,12"
                            ToolTip="Ir a Proyectos"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{x:Static models:NavigationSection.Projects}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
