<UserControl x:Class="MetroCarpinteria.App.Views.CashRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <Grid x:Name="PageRoot"
          Background="{DynamicResource ContentBackgroundBrush}"
          Opacity="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel MaxWidth="1000">
                <TextBlock Text="Caja"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding BalanceSummary}"
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,16" />

                <!-- La plata del taller, en un número.
                     Acá hubo dos intentos peores. Primero «Entró/Salió» al lado del saldo
                     por medio: cuatro números para decir dos cosas, y dos de ellos dando
                     igual sin que nada explicara por qué. Después el saldo partido en «en
                     el banco» y «en el cajón», que es una división que el taller no hace:
                     la plata es toda de uno, sin importar por dónde entró. El medio sí
                     importa, pero en cada movimiento del historial, no partiendo el total. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Caja fuerte" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Balance.BalanceDisplay}"
                                   FontSize="34" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{DynamicResource PrimaryBrownBrush}" />
                        <TextBlock Text="Lo que hay hoy en el taller."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,2,0,0" />

                        <TextBlock Style="{StaticResource SubtitleStyle}" FontSize="12"
                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="{Binding HistorySummary}" />
                    </StackPanel>
                </Border>

                <!-- Solo cuando hay una duda de verdad.
                     Acá vivía una tarjeta de «revisá el saldo y confirmalo» que salía
                     siempre después de migrar: pedía leer un desglose y apretar un botón
                     para seguir usando la app. Era ceremonia. De dónde sale cada peso ya
                     está en el historial de abajo, renglón por renglón, así que la tarjeta
                     lo repetía. Queda solo el caso que el historial no puede contestar
                     solo: una apertura vieja que puede estar contada dos veces. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                        Visibility="{Binding ShowSuspiciousNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SuspiciousSummary}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,10" FontSize="13"
                                   Text="Las cajas viejas no arrastraban saldo: cada una se abría con un monto escrito a mano. Si ahí anotaste lo que te había quedado del día anterior, esa plata quedó sumada dos veces." />

                        <ItemsControl ItemsSource="{Binding SuspiciousOpenings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" />
                                        <Button Content="Descontarla"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Left" Padding="10,4" FontSize="12"
                                                Margin="0,6,0,0"
                                                Command="{Binding DataContext.DiscardOpeningCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Está bien así" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left" Padding="10,4" FontSize="12" Margin="0,12,0,0"
                                ToolTip="Deja el saldo como está y no vuelve a preguntar"
                                Command="{Binding DismissSuspiciousCommand}" />
                    </StackPanel>
                </Border>

                <!-- Registrar un movimiento suelto: un gasto del taller, plata que se
                     saca. Los cobros no entran por acá, entran desde el trabajo. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Registrar movimiento" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Un gasto del taller, o plata que sacás. Las señas y cobros se registran desde el trabajo."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,2,0,12" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="Ingreso" IsChecked="{Binding MovementIsIncome}" Margin="0,0,16,0" />
                            <RadioButton Content="Egreso" />
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Monto" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MovementAmount, UpdateSourceTrigger=PropertyChanged}" Padding="8,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Medio" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding MovementMethods}"
                                          SelectedItem="{Binding MovementMethod}"
                                          DisplayMemberPath="Label" Padding="8,8" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Motivo" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding MovementReason, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,8" Margin="0,0,0,12" />

                        <Button Content="Registrar" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Command="{Binding RegisterMovementCommand}" />
                    </StackPanel>
                </Border>

                <!-- El historial. Sacado el arqueo, esta lista ES el control de la plata:
                     siempre visible, con el origen de cada peso y el saldo que quedaba
                     después de cada movimiento. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Movimientos" Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" MinWidth="170"
                                      ItemsSource="{Binding FilterMethods}"
                                      SelectedItem="{Binding FilterMethod}"
                                      DisplayMemberPath="Label" Padding="8,6" />
                        </Grid>
                        <TextBlock Text="Todo lo que entró y salió, con de dónde vino y cuánto quedaba después."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <ListView ItemsSource="{Binding Movements}"
                                  MaxHeight="460"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Fecha" Width="90"
                                                    DisplayMemberBinding="{Binding DateDisplay}" />
                                    <GridViewColumn Header="Tipo" Width="70"
                                                    DisplayMemberBinding="{Binding TypeLabel}" />
                                    <GridViewColumn Header="Medio" Width="105"
                                                    DisplayMemberBinding="{Binding MethodLabel}" />
                                    <GridViewColumn Header="Motivo" Width="290">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding OriginDisplay}"
                                                               Style="{StaticResource SubtitleStyle}"
                                                               FontSize="11"
                                                               Visibility="{Binding HasOrigin, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Importe" Width="115"
                                                    DisplayMemberBinding="{Binding AmountDisplay}" />
                                    <GridViewColumn Header="Quedaba" Width="115"
                                                    DisplayMemberBinding="{Binding RunningBalanceDisplay}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Text="Todavía no hay movimientos registrados."
                                   Style="{StaticResource SubtitleStyle}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasMovements, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- PageRoot arranca en Opacity 0 y esto lo hace aparecer. Sin este trigger la
         pantalla queda invisible para siempre: se dibuja entera y no se ve nada. -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
