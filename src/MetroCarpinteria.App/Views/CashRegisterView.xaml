<UserControl x:Class="MetroCarpinteria.App.Views.CashRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <Grid x:Name="PageRoot"
          Background="{DynamicResource ContentBackgroundBrush}"
          Opacity="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel MaxWidth="1000">
                <TextBlock Text="Caja"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding BalanceSummary}"
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,16" />

                <!-- Revisión de la conversión. Aparece una sola vez, cuando la caja
                     viene de las sesiones viejas: preguntarle «¿está bien este número?»
                     sin mostrarle de dónde sale no se puede contestar. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                        Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Revisá el saldo de tu caja" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" FontSize="13"
                                   Text="La caja ya no se abre ni se cierra: ahora es un saldo que corre. Lo que tenías en las cajas viejas se convirtió en movimientos. Mirá de dónde sale el número y confirmá que es el que tenés." />

                        <TextBlock Text="{Binding ReviewBalanceDisplay}"
                                   FontSize="30" FontWeight="Bold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource PrimaryBrownBrush}" />

                        <ItemsControl ItemsSource="{Binding ReviewOrigins}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}"
                                                   FontSize="13" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Lo que no se puede saber con certeza, pero sí señalar: una
                             apertura igual al cierre anterior puede ser plata contada
                             dos veces. La decisión es suya. -->
                        <Border Style="{StaticResource AccentNoticeStyle}" Margin="0,0,0,12"
                                Visibility="{Binding HasSuspiciousOpenings, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SuspiciousSummary}" FontWeight="SemiBold" FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SuspiciousOpenings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" />
                                                <Button Content="Descontarla"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        HorizontalAlignment="Left" Padding="10,4" FontSize="12"
                                                        Margin="0,6,0,0"
                                                        Command="{Binding DataContext.DiscardOpeningCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl,
                                                                  AncestorLevel=2}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                                   Style="{StaticResource SubtitleStyle}"
                                   Text="Si el total no coincide con lo que tenés, registrá abajo un movimiento por la diferencia antes de confirmar." />

                        <Button Content="Es lo que tengo, confirmar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{Binding ConfirmReviewCommand}" />
                    </StackPanel>
                </Border>

                <!-- La plata que hay. Va arriba de todo porque es lo primero que se
                     mira al entrar, y abierta por medio para no confundir lo que está
                     en el cajón con lo que está en el banco. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Caja fuerte" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Balance.BalanceDisplay}"
                                   FontSize="34" FontWeight="Bold" Margin="0,8,0,0"
                                   Foreground="{DynamicResource PrimaryBrownBrush}" />
                        <TextBlock Text="Todo lo que entró menos todo lo que salió, desde siempre."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,2,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Entró" Style="{StaticResource SubtitleStyle}" />
                                <TextBlock Text="{Binding Balance.IncomeDisplay}" FontWeight="SemiBold" FontSize="16" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Salió" Style="{StaticResource SubtitleStyle}" />
                                <TextBlock Text="{Binding Balance.ExpenseDisplay}" FontWeight="SemiBold" FontSize="16" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding MethodTotals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding MethodLabel}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding BalanceDisplay}"
                                                   FontSize="13" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Registrar un movimiento suelto: un gasto del taller, plata que se
                     saca. Los cobros no entran por acá, entran desde el trabajo. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Registrar movimiento" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Un gasto del taller, o plata que sacás. Las señas y cobros se registran desde el trabajo."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,2,0,12" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="Ingreso" IsChecked="{Binding MovementIsIncome}" Margin="0,0,16,0" />
                            <RadioButton Content="Egreso" />
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Monto" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MovementAmount, UpdateSourceTrigger=PropertyChanged}" Padding="8,8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Medio" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding MovementMethods}"
                                          SelectedItem="{Binding MovementMethod}"
                                          DisplayMemberPath="Label" Padding="8,8" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Motivo" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding MovementReason, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,8" Margin="0,0,0,12" />

                        <Button Content="Registrar" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Command="{Binding RegisterMovementCommand}" />
                    </StackPanel>
                </Border>

                <!-- El historial. Sacado el arqueo, esta lista ES el control de la plata:
                     siempre visible, con el origen de cada peso y el saldo que quedaba
                     después de cada movimiento. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Movimientos" Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" MinWidth="170"
                                      ItemsSource="{Binding FilterMethods}"
                                      SelectedItem="{Binding FilterMethod}"
                                      DisplayMemberPath="Label" Padding="8,6" />
                        </Grid>
                        <TextBlock Text="Todo lo que entró y salió, con de dónde vino y cuánto quedaba después."
                                   Style="{StaticResource SubtitleStyle}" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <ListView ItemsSource="{Binding Movements}"
                                  MaxHeight="460"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Fecha" Width="90"
                                                    DisplayMemberBinding="{Binding DateDisplay}" />
                                    <GridViewColumn Header="Tipo" Width="70"
                                                    DisplayMemberBinding="{Binding TypeLabel}" />
                                    <GridViewColumn Header="Medio" Width="105"
                                                    DisplayMemberBinding="{Binding MethodLabel}" />
                                    <GridViewColumn Header="Motivo" Width="290">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding OriginDisplay}"
                                                               Style="{StaticResource SubtitleStyle}"
                                                               FontSize="11"
                                                               Visibility="{Binding HasOrigin, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Importe" Width="115"
                                                    DisplayMemberBinding="{Binding AmountDisplay}" />
                                    <GridViewColumn Header="Quedaba" Width="115"
                                                    DisplayMemberBinding="{Binding RunningBalanceDisplay}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Text="Todavía no hay movimientos registrados."
                                   Style="{StaticResource SubtitleStyle}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasMovements, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- PageRoot arranca en Opacity 0 y esto lo hace aparecer. Sin este trigger la
         pantalla queda invisible para siempre: se dibuja entera y no se ve nada. -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
