<UserControl x:Class="MetroCarpinteria.App.Views.CashRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <Grid x:Name="PageRoot"
          Background="{StaticResource ContentBackgroundBrush}"
          Opacity="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel MaxWidth="1000">
                <TextBlock Text="Caja"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding SessionSummary}"
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding OpenedAtDisplay}"
                           Foreground="{StaticResource PrimaryBrownBrush}"
                           FontSize="13"
                           Margin="0,0,0,16"
                           Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Status -->
                <Border CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1A4A7C59" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Background" Value="#1AC45C26" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0">
                        <!-- Open session -->
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock Text="Abrir caja"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,16" />
                                <TextBlock Text="Monto inicial en efectivo"
                                           Style="{StaticResource SubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding OpenAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Margin="0,0,0,12" />
                                <TextBlock Text="Notas (opcional)"
                                           Style="{StaticResource SubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding OpenNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Margin="0,0,0,16" />
                                <Button Content="Abrir caja"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenSessionCommand}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Current session summary -->
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Sesión actual"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,16" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Apertura" Style="{StaticResource SubtitleStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSession.OpeningDisplay}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ingresos" Style="{StaticResource SubtitleStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSession.IncomeDisplay}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Egresos" Style="{StaticResource SubtitleStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSession.ExpenseDisplay}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AlertBrush}" />
                                </Grid>
                                <Rectangle Height="1" Fill="#1A3D2914" Margin="0,8,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Efectivo esperado"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentSession.ExpectedDisplay}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrownBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Register movement -->
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Registrar movimiento"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,16" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton Content="Ingreso"
                                                 IsChecked="{Binding MovementIsIncome, Mode=TwoWay}"
                                                 GroupName="CashMovementType"
                                                 Margin="0,0,16,0"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                    <RadioButton Content="Egreso"
                                                 IsChecked="{Binding MovementIsIncome, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                                 GroupName="CashMovementType"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Monto" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MovementAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Margin="0,0,0,12" />
                                <TextBlock Text="Motivo" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding MovementReason, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Margin="0,0,0,16"
                                         MinHeight="50"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                                <Button Content="Registrar"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding RegisterMovementCommand}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Close session -->
                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Cerrar caja"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,16" />
                                <TextBlock Text="Efectivo contado"
                                           Style="{StaticResource SubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding CloseCountedAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Margin="0,0,0,12" />
                                <TextBlock Text="Notas de cierre (opcional)"
                                           Style="{StaticResource SubtitleStyle}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding CloseNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         Margin="0,0,0,16" />
                                <Button Content="Cerrar caja"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding CloseSessionCommand}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="2">
                        <!-- Today's movements -->
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,0,0,16"
                                Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Movimientos de la sesión"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,12" />
                                <ListView ItemsSource="{Binding Movements}"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          MaxHeight="320">
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:CashMovementListItem}">
                                            <Border Padding="0,8" BorderBrush="#1A3D2914" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                   FontWeight="SemiBold"
                                                                   Width="60"
                                                                   Foreground="{StaticResource PrimaryBrownBrush}" />
                                                        <TextBlock Text="{Binding AmountDisplay}"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsIncome}" Value="False">
                                                                            <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}"
                                                               Style="{StaticResource SubtitleStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding CreatedAtLocal, StringFormat=dd/MM/yyyy HH:mm}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- History -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Historial de cajas"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Button Content="Actualizar"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding LoadCommand}"
                                            HorizontalAlignment="Right"
                                            Padding="14,8"
                                            FontSize="12" />
                                </Grid>
                                <ListView ItemsSource="{Binding SessionHistory}"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          MaxHeight="400">
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:CashSessionListItem}">
                                            <Border Padding="0,10" BorderBrush="#1A3D2914" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,12,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding PeriodDisplay}"
                                                                   Style="{StaticResource SubtitleStyle}" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}">
                                                        <Run Text="Apertura: " />
                                                        <Run Text="{Binding OpeningDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="  ·  Esperado: " />
                                                        <Run Text="{Binding ExpectedDisplay, Mode=OneWay}" />
                                                        <Run Text="  ·  Contado: " />
                                                        <Run Text="{Binding CountedDisplay, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                                               FontSize="12"
                                                               Margin="0,4,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="Diferencia: " />
                                                        <Run Text="{Binding DifferenceDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
