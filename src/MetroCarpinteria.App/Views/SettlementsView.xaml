<UserControl x:Class="MetroCarpinteria.App.Views.SettlementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:MetroCarpinteria.App.Controls"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <Grid x:Name="PageRoot" Background="{DynamicResource ContentBackgroundBrush}" Opacity="0">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Trabajos terminados" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Los trabajos cerrados, con lo que le toca a cada uno. Lo que pagues sale de la caja."
                           Style="{StaticResource SubtitleStyle}" Margin="0,0,0,16" />

                <!-- Lo primero que él pide es el agregado: cuánta plata debe en total. Por eso
                     esta pantalla es propia y no un filtro de Proyectos. -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Mano de obra sin pagar" Style="{StaticResource SubtitleStyle}" />
                        <TextBlock Text="{Binding TotalPendingDisplay, Converter={StaticResource PrivacyMaskConverter}}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrownBrush}"
                                   Margin="0,2,0,2" />
                        <TextBlock Text="{Binding HeadlineDetail}" Style="{StaticResource SubtitleStyle}" />

                        <ItemsControl ItemsSource="{Binding Debts}" Margin="0,10,0,0"
                                      Visibility="{Binding HasDebts, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SettlementDebtItem}">
                                    <Border Background="{DynamicResource StateWarningSurfaceBrush}"
                                            CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <!-- El quién y el cuánto, separados: con el modo
                                             privado se va el importe y el nombre queda. -->
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AlertBrush}">
                                            <Run Text="{Binding Who, Mode=OneWay}" />
                                            <Run Text="{Binding PendingDisplay, Mode=OneWay, Converter={StaticResource PrivacyMaskConverter}}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding LoadCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                              BorderThickness="0"
                              ctl:Ui.EmptyIcon="🪚"
                              ctl:Ui.EmptyTitle="Todavía no hay trabajos terminados"
                              ctl:Ui.EmptyMessage="Cuando marques un trabajo como listo en Proyectos, aparece acá para liquidarlo.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trabajo" Binding="{Binding Title}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClientName}" Width="110" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding BudgetDisplay, Converter={StaticResource PrivacyMaskConverter}}" Width="105" />
                            <DataGridTemplateColumn Header="Mano de obra" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding StatusLabel, Converter={StaticResource PrivacyMaskConverter}}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryBrownBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding UpdatedDisplay}" FontSize="11"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <!-- Para poder ver de una cuáles trabajos hay que mirar con
                                                 cuidado antes de pagar, sin entrar en cada uno. -->
                                            <TextBlock Text="{Binding HandPaidNote}" FontSize="11"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AlertBrush}"
                                                       Visibility="{Binding HandPaidNote, Converter={StaticResource StringToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelectedProject, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <!-- El desglose que pidió: cuánto es del desperdicio, cuánto de las
                             herramientas, cuánto es lo suyo y cuánto de cada operario. -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding HasBreakdown, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="DESGLOSE DEL TRABAJO" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="De acá sale cada número. Es el mismo cálculo con el que se cotizó."
                                           Style="{StaticResource SubtitleStyle}" Margin="0,0,0,12" />

                                <!-- Cuando gastó más material del que cotizó, el desglose solo
                                     no alcanza: muestra lo cotizado, que es lo que armó el
                                     precio, y no lo que realmente salió del depósito. -->
                                <Border Background="{DynamicResource StateWarningSurfaceBrush}"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                        Visibility="{Binding SelectedProject.HasMaterialsNote, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SelectedProject.MaterialsNote, Converter={StaticResource PrivacyMaskConverter}}"
                                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AlertBrush}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding BreakdownLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:BudgetBreakdownLine}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="13" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding Detail, Converter={StaticResource StringToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay, Converter={StaticResource PrivacyMaskConverter}}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding ShowNoWorkersNote, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding NoWorkersMessage}" TextWrapping="Wrap"
                                       Style="{StaticResource SubtitleStyle}" />
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding HasWorkers, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="A QUIÉN LE TOCA" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Elegí a alguien para pagarle. Podés pagar de a partes."
                                           Style="{StaticResource SubtitleStyle}" Margin="0,0,0,12" />

                                <DataGrid ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}"
                                          BorderThickness="0" Background="Transparent" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Quién" Binding="{Binding Description}" Width="*" MinWidth="100" />
                                        <DataGridTextColumn Header="Jornal" Binding="{Binding RateDisplay, Converter={StaticResource PrivacyMaskConverter}}" Width="150" />
                                        <DataGridTextColumn Header="Le toca" Binding="{Binding DueDisplay, Converter={StaticResource PrivacyMaskConverter}}" Width="105" />
                                        <DataGridTextColumn Header="Cobró" Binding="{Binding PaidDisplay, Converter={StaticResource PrivacyMaskConverter}}" Width="105" />
                                        <DataGridTextColumn Header="Falta" Binding="{Binding PendingDisplay, Converter={StaticResource PrivacyMaskConverter}}" Width="105" />
                                        <DataGridTemplateColumn Header="Estado" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding HandPaidRowNote}" FontSize="11"
                                                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AlertBrush}"
                                                                   Visibility="{Binding HandPaidRowNote, Converter={StaticResource StringToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}"
                                Visibility="{Binding HasSelectedWorker, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding PayHeader}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedWorker.ProgressDisplay, Converter={StaticResource PrivacyMaskConverter}}"
                                           Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <!-- El jornal que él marcó a mano antes de que esto existiera no
                                     dejó movimiento, así que la cuenta lo da pendiente. El único
                                     que sabe si ya lo pagó es él: el aviso va donde apretaría. -->
                                <Border Background="{DynamicResource StateWarningSurfaceBrush}"
                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                        Visibility="{Binding SelectedWorker.ShowHandPaidWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SelectedWorker.HandPaidWarning, Converter={StaticResource PrivacyMaskConverter}}"
                                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AlertBrush}" />
                                </Border>

                                <TextBlock Text="Importe" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,4"
                                         ToolTip="Viene cargado con lo que falta, pero lo podés cambiar" />
                                <TextBlock Text="Sale de la caja como un egreso, con el trabajo y la persona anotados."
                                           Style="{StaticResource SubtitleStyle}" FontSize="11" Margin="0,0,0,12" />

                                <TextBlock Text="Medio" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding PayMethods}" SelectedItem="{Binding PayMethod}"
                                          DisplayMemberPath="Label" Padding="8,8" Margin="0,0,0,14" />

                                <WrapPanel>
                                    <Button Content="Registrar el pago" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PayCommand}" Margin="0,0,10,0" />
                                    <Button Content="Saldar lo que falta" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding PayAllCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
