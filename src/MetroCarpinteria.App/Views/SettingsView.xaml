<UserControl x:Class="MetroCarpinteria.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900">
    <Grid x:Name="PageRoot"
          Background="{DynamicResource ContentBackgroundBrush}"
          Opacity="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
            <StackPanel MaxWidth="900">
                <TextBlock Text="Configuración"
                           Style="{StaticResource PageTitleStyle}"
                           Margin="0,0,0,8" />
                <TextBlock Text="Datos locales, respaldos y preferencias de la aplicación."
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,24" />

                <!-- Apariencia: se aplica al instante, sin botón de guardar -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Apariencia" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource SubtitleStyle}" Margin="0,0,0,16"
                                   Text="El cambio se ve al instante y queda guardado para la próxima vez." />

                        <TextBlock Text="Tema" Style="{StaticResource FieldLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding ThemeOptions}" Margin="0,0,0,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="AppTheme"
                                                 Margin="0,0,20,8"
                                                 Content="{Binding Label}"
                                                 ToolTip="{Binding Description}"
                                                 AutomationProperties.HelpText="{Binding Description}"
                                                 Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding}">
                                        <RadioButton.IsChecked>
                                            <!-- Comparado contra la opción elegida del ViewModel,
                                                 que es quien decide; el clic va por el comando. -->
                                            <MultiBinding Converter="{StaticResource SelectedOptionConverter}" Mode="OneWay">
                                                <Binding Path="." />
                                                <Binding Path="DataContext.SelectedTheme"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Tamaño de letra" Style="{StaticResource FieldLabelStyle}" />
                        <ItemsControl ItemsSource="{Binding ScaleOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="AppScale"
                                                 Margin="0,0,20,4"
                                                 Content="{Binding Label}"
                                                 Command="{Binding DataContext.SelectScaleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource SelectedOptionConverter}" Mode="OneWay">
                                                <Binding Path="." />
                                                <Binding Path="DataContext.SelectedScale"
                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Actualizaciones -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Actualizaciones"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SubtitleStyle}" VerticalAlignment="Center"
                                       Text="Versión instalada" />
                            <TextBlock Text="{Binding CurrentVersionDisplay}" HorizontalAlignment="Right"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <!-- Aviso destacado cuando ya está bajada y espera el cierre -->
                        <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                                Background="{DynamicResource StateSuccessSurfaceBrush}"
                                Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>

                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource SubtitleStyle}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                        <ProgressBar Height="6" Margin="0,0,0,12"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding UpdateProgress, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentGoldBrush}"
                                     Background="{DynamicResource BorderBrushToken}" BorderThickness="0"
                                     Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <CheckBox Content="Buscar actualizaciones automáticamente al abrir"
                                  IsChecked="{Binding CheckUpdatesOnStartup}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,8"
                                  ToolTip="Solo revisa si hay internet. Sin conexión la app funciona igual." />

                        <TextBlock Margin="0,0,0,16" FontSize="12">
                            <Run Text="Última consulta: " Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run Text="{Binding LastUpdateCheckDisplay, Mode=OneWay}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                        </TextBlock>

                        <WrapPanel>
                            <Button Content="Buscar actualizaciones"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CheckUpdatesCommand}"
                                    Margin="0,0,10,0" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Las actualizaciones se instalan solas al cerrar la aplicación. Tus datos y respaldos no se tocan: viven en la carpeta de Documentos." />
                    </StackPanel>
                </Border>

                <!-- Data paths -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Ubicación de datos"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16" />
                        <TextBlock Text="Carpeta principal"
                                   Style="{StaticResource SubtitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding RootDirectory, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Margin="0,0,0,12"
                                 Padding="10,8"
                                 Background="{DynamicResource SurfaceSunkenBrush}"
                                 BorderBrush="{DynamicResource BorderStrongBrush}" />
                        <TextBlock Text="Base de datos (SQLite)"
                                   Style="{StaticResource SubtitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding DatabasePath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Margin="0,0,0,12"
                                 Padding="10,8"
                                 Background="{DynamicResource SurfaceSunkenBrush}"
                                 BorderBrush="{DynamicResource BorderStrongBrush}" />
                        <TextBlock Text="Carpeta de respaldos"
                                   Style="{StaticResource SubtitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding BackupsDirectory, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Margin="0,0,0,16"
                                 Padding="10,8"
                                 Background="{DynamicResource SurfaceSunkenBrush}"
                                 BorderBrush="{DynamicResource BorderStrongBrush}" />
                        <WrapPanel>
                            <Button Content="Abrir carpeta de datos"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenDataFolderCommand}"
                                    Margin="0,0,12,0" />
                            <Button Content="Abrir respaldos"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenBackupsFolderCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Backup settings -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Respaldo automático"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16" />
                        <CheckBox Content="Crear respaldo al cerrar la aplicación"
                                  IsChecked="{Binding BackupOnExit}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontSize="14"
                                  Margin="0,0,0,16" />
                        <TextBlock Text="Cantidad máxima de respaldos guardados"
                                   Style="{StaticResource SubtitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding MaxBackupFiles, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 HorizontalAlignment="Left"
                                 Padding="10,8"
                                 Margin="0,0,0,12" />
                        <TextBlock Margin="0,0,0,16">
                            <Run Text="Último respaldo: " Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run Text="{Binding LastBackupDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </TextBlock>
                        <WrapPanel>
                            <Button Content="Guardar configuración"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveSettingsCommand}"
                                    Margin="0,0,12,0" />
                            <Button Content="Respaldar ahora"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BackupNowCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Recent backups -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Respaldos recientes"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button Content="Actualizar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshBackupsCommand}"
                                    HorizontalAlignment="Right"
                                    Padding="14,8"
                                    FontSize="12" />
                        </Grid>
                        <ListView ItemsSource="{Binding RecentBackups}"
                                  SelectedItem="{Binding SelectedBackup}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  MaxHeight="220">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Archivo" Width="220" DisplayMemberBinding="{Binding FileName}" />
                                    <GridViewColumn Header="Fecha" Width="150" DisplayMemberBinding="{Binding CreatedAtLocal, StringFormat=dd/MM/yyyy HH:mm}" />
                                    <GridViewColumn Header="Tamaño" Width="80" DisplayMemberBinding="{Binding SizeDisplay}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Restaurar seleccionado"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RestoreBackupCommand}"
                                    Margin="0,0,12,0" />
                        </WrapPanel>
                        <TextBlock Text="Los datos se guardan solo en tu PC. Al restaurar, se crea una copia de seguridad previa automáticamente."
                                   Style="{StaticResource SubtitleStyle}"
                                   Margin="0,16,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Copiar o restaurar la base son los dos únicos momentos en que la app tarda de
             verdad. Sin este aviso, Windows pinta la ventana de gris y parece colgada. -->
        <Border Style="{StaticResource BusyOverlayStyle}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource BusySurfaceStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding BusyMessage}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="No cierres la aplicación."
                               FontSize="{DynamicResource FontSizeCaption}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,0" Width="200" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
