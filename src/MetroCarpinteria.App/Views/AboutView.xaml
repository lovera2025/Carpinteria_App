<UserControl x:Class="MetroCarpinteria.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MetroCarpinteria.App.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <Grid x:Name="PageRoot" Opacity="0">
        <controls:AnimatedBackground />

        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="24"
                    MaxWidth="720"
                    Width="720"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.18" Color="#3D2914" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hero -->
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/MetroCarpinteria;component/Assets/banner.jpeg" Stretch="UniformToFill" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#E61A1614" Offset="0" />
                                    <GradientStop Color="#991A1614" Offset="0.55" />
                                    <GradientStop Color="#661A1614" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel VerticalAlignment="Center" Margin="40,0">
                            <Image Source="pack://application:,,,/MetroCarpinteria;component/Assets/logo-horizontal.jpeg"
                                   Height="64"
                                   HorizontalAlignment="Left"
                                   Stretch="Uniform"
                                   Margin="0,0,0,12" />
                            <TextBlock Text="{Binding BrandName}"
                                       Foreground="{DynamicResource TextOnDarkBrush}"
                                       FontSize="26"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <!-- Info -->
                    <StackPanel Grid.Row="1" Margin="40,32,40,24">
                        <TextBlock Text="{Binding Tagline}"
                                   FontSize="18"
                                   Foreground="{DynamicResource PrimaryBrownBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ContactLine}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="14"
                                   Margin="0,0,0,24" />

                        <TextBlock Text="Sistema de gestión local"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   LineHeight="22"
                                   Margin="0,0,0,16">
                            Inventario, caja, proyectos y personal en un solo lugar.
                            Tus datos se guardan en esta computadora, sin necesidad de internet.
                        </TextBlock>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Versión" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding AppVersion}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Datos locales" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding DatabasePath}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Footer: marca izquierda · desarrollador derecha -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SidebarDarkBrush}"
                            Padding="28,18">
                        <Grid>
                            <TextBlock Text="{Binding BrandName}"
                                       Foreground="{DynamicResource AccentGoldBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DeveloperLine}"
                                       Foreground="{DynamicResource TextOnDarkBrush}"
                                       Opacity="0.75"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
