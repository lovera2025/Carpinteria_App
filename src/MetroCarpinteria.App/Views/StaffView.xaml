<UserControl x:Class="MetroCarpinteria.App.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MetroCarpinteria.App.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:MetroCarpinteria.App.Controls"
             d:DesignHeight="700"
             d:DesignWidth="1000">
    <Grid x:Name="PageRoot" Background="{DynamicResource ContentBackgroundBrush}" Opacity="0">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Personal" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Colaboradores del taller y sus asignaciones a proyectos."
                           Style="{StaticResource SubtitleStyle}" Margin="0,0,0,16" />
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="+ Nuevo empleado" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewEmployeeCommand}" Margin="0,0,10,8" />
                    <Button Content="Editar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditEmployeeCommand}" Margin="0,0,10,8" />
                    <Button Content="Archivar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ArchiveEmployeeCommand}" Margin="0,0,10,8" />
                    <Button Content="Restaurar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RestoreEmployeeCommand}" Margin="0,0,10,8" />
                    <!-- ShowOnDisabled: el tooltip explica justamente por qué está gris,
                         y sin esto es lo único que WPF no muestra. -->
                    <Button Content="Eliminar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DeleteEmployeeCommand}" Margin="0,0,10,8"
                            ToolTip="{Binding DeleteBlockTooltip}"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Content="Actualizar" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadCommand}" Margin="0,0,10,8" />
                </WrapPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,10" Margin="0,0,12,0"
                             ctl:Ui.IsSectionSearchBox="True"
                             ctl:Ui.Placeholder="Buscar por nombre…"
                             AutomationProperties.Name="Buscar empleado"
                             ToolTip="Buscar por nombre (Ctrl+F)" />
                    <CheckBox Grid.Column="1" Content="Ver archivados" IsChecked="{Binding ShowArchived}"
                              VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" BorderThickness="0"
                              ctl:Ui.EmptyIcon="👷"
                              ctl:Ui.EmptyTitle="Todavía no cargaste a nadie"
                              ctl:Ui.EmptyMessage="Agregá a quienes trabajan en el taller para poder asignarlos a los proyectos.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="120" />
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="110" />
                            <DataGridTextColumn Header="Proyectos" Binding="{Binding ActiveAssignmentCount}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FormHeader}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
                                <TextBlock Text="Nombre completo" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <TextBlock Text="Teléfono" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,12" />
                                <TextBlock Text="Rol / especialidad" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormRole, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" Margin="0,0,0,16" />
                                <WrapPanel>
                                    <Button Content="Guardar" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SaveEmployeeCommand}" Margin="0,0,10,0" />
                                    <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CancelFormCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Asignaciones a proyectos" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <TextBlock Margin="0,0,0,12">
                                    <Run Text="Empleado: " Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text="{Binding SelectedEmployee.FullName, Mode=OneWay, FallbackValue='—'}"
                                         FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Assignments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProjectAssignmentItem}">
                                            <Border Padding="0,8" BorderBrush="{DynamicResource BorderBrushToken}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ProjectTitle}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource SubtitleStyle}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding AssignedAtLocal, StringFormat=dd/MM/yyyy HH:mm}"
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PageRoot" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
